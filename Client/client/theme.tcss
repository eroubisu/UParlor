/* UParlor 全局样式 — 极简终端风格 */
/* 大厅主界面纯灰度，游戏内容可用彩色 */

* {
    background: transparent;
    scrollbar-size: 1 1;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
    scrollbar-color: $color-border;
    scrollbar-color-hover: $color-border-light;
    scrollbar-color-active: $color-border-light;
}

Static, Horizontal, Vertical {
    background: transparent;
}

Screen {
    layout: vertical;
    background: ansi_default;
    layers: default windows floating overlay;
    align: center middle;
    overflow: hidden hidden;
}

/* ── footer ── */

#footer-bar {
    dock: bottom;
    height: 1;
    width: 1fr;
    background: transparent;
    layer: overlay;
    padding: 0 0 0 1;
}

#footer-bar > Static {
    height: 1;
    width: auto;
    background: transparent;
    color: $color-fg-secondary;
}

#footer-bar > #footer-spacer {
    width: 1fr;
}

#footer-bar > #mode-indicator {
    background: $color-fg-primary;
    color: #1a1a1a;
}

#terminal-size-warning {
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
    background: ansi_default;
    color: $color-fg-secondary;
    content-align: center middle;
}

/* ── Input ── */

Input {
    background: transparent;
}

Input:disabled {
    background: transparent;
    opacity: 1.0;
}

Input > .input--cursor {
    background: $color-fg-primary;
    color: #1a1a1a;
}

/* ── 全屏 Window 避开底栏 ── */

Window.-primary {
    margin-bottom: 1;
}

/* ── 聚焦指示 ── */
Window.-active Panel.-focused {
    border: round $color-fg-secondary;
    border-title-color: $color-fg-primary;
}

/* ── 聊天浮窗 ── */
#chat-window {
    margin-bottom: 1;
}

/* ── iOS 连接二维码 ── */
/* 必须写在这里：上面的 `Static { background: transparent }` 会覆盖窗口
   DEFAULT_CSS 里的 background，二维码会变成黑底黑块而扫不出来。 */
#remote-qr {
    background: #ffffff;
    color: #000000;
}
